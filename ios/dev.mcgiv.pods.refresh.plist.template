<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.mcgiv.pods.refresh</string>
	<key>ProgramArguments</key>
	<array>
		<string>__ROOT__/ios/refresh-if-due.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>IOS_DEVICE_ID</key>
		<string>__DEVICE_ID__</string>
		<key>IOS_XCODE_DESTINATION</key>
		<string>__XCODE_DESTINATION__</string>
		<key>IOS_TEAM_ID</key>
		<string>__TEAM_ID__</string>
		<key>IOS_REFRESH_SUCCESS_INTERVAL_SECONDS</key>
		<string>__SUCCESS_INTERVAL_SECONDS__</string>
		<key>IOS_PROFILE_RENEWAL_WINDOW_SECONDS</key>
		<string>__PROFILE_RENEWAL_WINDOW_SECONDS__</string>
		<key>IOS_PROFILE_WARNING_SECONDS</key>
		<string>__PROFILE_WARNING_SECONDS__</string>
		<key>IOS_PROFILE_CRITICAL_SECONDS</key>
		<string>__PROFILE_CRITICAL_SECONDS__</string>
		<key>IOS_NOTIFY_FAILURE</key>
		<string>0</string>
		<key>IOS_SIGNING_ALERTS_ENABLED</key>
		<string>1</string>
		<key>IOS_SIGNING_REMINDERS_ENABLED</key>
		<string>1</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StartInterval</key>
	<integer>__CHECK_INTERVAL_SECONDS__</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__ROOT__/ios/build/launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>__ROOT__/ios/build/launchd.err.log</string>
</dict>
</plist>
